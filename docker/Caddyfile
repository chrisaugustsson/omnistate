# The reverse proxy: the one address that the browser, the omni CLI and the
# agents use. The API owns /api and /ws; everything else is the web app.
{
	auto_https off
	admin off
}

:80 {
	@api path /api /api/*
	# A design's outline is about 1 MB of JSON; it is the longest request of
	# opening a big design, and compressed it is a fraction of that.
	handle @api {
		encode zstd gzip
		reverse_proxy api:8080
	}

	@ws path /ws /ws/*
	handle @ws {
		reverse_proxy api:8080
	}

	# The design renderer (web/public/render/, built by `make render-wasm`) is
	# served at a fixed URL, and a browser that kept an older build without
	# asking would load a module that lacks the functions the page calls. The
	# browser asks every time, and gets 304 while it is current. (`>` sets the
	# header on whatever the web app answers.)
	@render path /render/*
	header @render >Cache-Control "no-cache"

	handle {
		reverse_proxy web:3000
	}
}
